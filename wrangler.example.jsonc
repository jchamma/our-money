// Template for your own installation. `npm run setup` copies it to wrangler.jsonc (gitignored)
// and fills in the values; you shouldn't need to edit it by hand.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-finance",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // The app's screens are static files, public like the GitHub code; every piece of data is behind
  // /api with a login, and only /api and /auth run the Worker.
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/auth/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-finance",
      "database_id": "00000000-0000-0000-0000-000000000000", // set by setup
      "migrations_dir": "migrations"
    }
  ],
  // Not secrets. Secrets (TOKEN_KEY; GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET, or BREVO_API_KEY) are
  // Cloudflare secrets, set by setup.
  "vars": {
    "AUTH_MODE": "passkey", // passkey | google | email
    "ALLOWED_EMAILS": "", // google and email modes: 1–2 comma-separated emails
    "EMAIL_FROM": "",
    "EMAIL_FROM_NAME": "הכסף שלנו"
  },
  // 03:00 UTC = 06:00 Israel summer time, 05:00 winter time. Syncs previous + current month.
  "triggers": { "crons": ["0 3 * * *"] }
}
